{
  "name": "zenhome",
  "version": "0.1.3",
  "description": "the web and mobile app for zenhome",
  "productName": "Zen Home | A home for all your home needs",
  "author": "James harrington <jamesdonaldharrington@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "eslint": "eslint",
    "lint": "eslint --fix .",
    "test": "npm run test:unit:ci && npm run test:e2e:ci",
    "start": "npm run dev",
    "dev": "concurrently -p \"[{name}]\" -n \"MOCK,QUASAR\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:mock-gql\" \"quasar dev\"",
    "dev:mock-gql": "nodemon -w mock mock/graphql/server.js -q",
    "build": "quasar build",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:ci": "vitest run --coverage",
    "test:component": "cross-env NODE_ENV=test cypress open --component --env ENV=test",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component --env ENV=test",
    "test:e2e": "cypress open",
    "test:e2e:ci": "concurrently -p \"[{name}]\" -n \"SERVER,CYPRESS\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run test:e2e:dev\" \"wait-on https://localhost:3000 && cypress run\"",
    "test:e2e:dev": "quasar dev --port 3000",
    "test:coverage": "npm run test:unit:ci && npm run test:e2e:ci",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "lt": "lt --port 2340 --local-https --allow-invalid-cert",
    "serve": "quasar serve dist/spa",
    "prepare": "husky install",
    "release": "chmod 775 ./scripts/* && ./scripts/release.sh",
    "start-sonar": "docker-compose up -d sonarqube",
    "static-code-analysis": "chmod 775 ./scripts/* &&  ./scripts/sonar-scanner.sh",
    "docs:gen": "jsdoc -c jsdoc.json",
    "docs:serve": "npx serve docs",
    "check-licenses": "license-checker --exclude 'MIT, MIT OR X11, BSD, ISC' --production --json --out licenses.json",
    "snyk-test": "snyk test"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.17",
    "pinia": "^3.0.1",
    "quasar": "^2.18.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/preset-env": "^7.26.9",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@cypress/code-coverage": "^3.14.0",
    "@eslint/js": "^9.23.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@lhci/cli": "^0.14.0",
    "@quasar/app-vite": "^2.2.0",
    "@quasar/vite-plugin": "^1.9.0",
    "@sentry/node": "^9.10.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/server-renderer": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "apollo-server-express": "^3.13.0",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "clean-jsdoc-theme": "^4.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "cypress": "^13.6.6",
    "eslint": "^9.23.0",
    "eslint-plugin-cypress": "^4.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^10.0.0",
    "express": "^4.21.2",
    "globals": "^16.0.0",
    "graphql": "^16.10.0",
    "graphql-compose": "^9.1.0",
    "graphql-tools": "^9.0.18",
    "happy-dom": "^17.4.4",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "inquirer": "^12.5.0",
    "jest-sonar-reporter": "^2.0.0",
    "js-yaml": "^4.1.0",
    "jsdoc": "^4.0.4",
    "jsdoc-vuejs": "^4.0.0",
    "jsdom": "^26.0.0",
    "license-checker": "^25.0.1",
    "localtunnel": "^2.0.2",
    "nodemon": "^3.1.9",
    "ora": "^8.2.0",
    "playwright-webkit": "^1.51.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "snyk": "^1.1296.1",
    "standard-version": "^9.5.0",
    "start-server-and-test": "^2.0.11",
    "supertest": "^7.1.0",
    "vite": "^5.4.15",
    "vite-jsconfig-paths": "^2.0.1",
    "vite-plugin-checker": "^0.9.1",
    "vite-plugin-istanbul": "^7.0.0",
    "vitest": "^3.0.9",
    "vue-loader": "^17.4.2",
    "wait-on": "^8.0.3",
    "webpack": "^5.98.0",
    "yargs": "^17.7.2"
  },
  "resolutions": {
    "@vitejs/plugin-vue": "^4.3.4",
    "vite": "^5.4.15",
    "axios": "^1.8.2",
    "ws": "^8.17.1",
    "happy-dom": "^15.10.2",
    "esbuild": "^0.25.0",
    "cookie": "^0.7.0"
  },
  "engines": {
    "node": "^20",
    "npm": "^10"
  },
  "jest": {
    "testResultsProcessor": "jest-sonar-reporter",
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ]
  }
}
