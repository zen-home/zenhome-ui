# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Branch validation
branch="$(git rev-parse --abbrev-ref HEAD)"

# Protected branches
if [ "$branch" = "main" ] || [ "$branch" = "dev" ]; then
  echo "${RED}Direct commits to ${branch} branch are not allowed${NC}"
  echo "Please create a feature branch and make a PR instead"
  exit 1
fi

# Branch naming convention
valid_branch_regex='^((fix|feat|release|chore|hotfix|refactor|style|docs|perf|test|build|ci|revert|wip)\/(\.|[a-zA-Z0-9\-])+)$'
if [[ ! $branch =~ $valid_branch_regex ]]; then
    echo "${RED}Invalid branch name${NC}"
    echo "Branch names must follow: type/name"
    echo "Types: fix, feat, release, chore, hotfix, refactor, style, docs, perf, test, build, ci, revert, wip"
    echo "Example: feat/user-auth"
    exit 1
fi

# Commit message validation
commit_msg=$(git log -1 --pretty=%B)

# Conventional Commits pattern
conventional_commit_regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z-]+\))?: .{1,}$'
if ! echo "$commit_msg" | grep -qE "$conventional_commit_regex"; then
    echo "${RED}Invalid commit message${NC}"
    echo "Format: type(scope): description"
    echo "Example: feat(auth): add login functionality"
    exit 1
fi

# Run checks
echo "${GREEN}Running lint${NC}"
npm run lint
echo "${GREEN}Running unit tests${NC}"
npm run test:unit:ci
